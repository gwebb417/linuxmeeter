{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linuxmeeter",
  "version": "0.2.1",
  "identifier": "com.stacksloth.linuxmeeter",
  "build": {
    "beforeDevCommand": "rm -rf ~/.local/share/com.stacksloth.linuxmeeter/WebKitCache; pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "linuxmeeter",
        "width": 1136,
        "height": 800,
        "decorations": false,
        "transparent": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Music",
    "shortDescription": "VoiceMeeter-style virtual audio mixer for PipeWire",
    "longDescription": "Route any app or microphone through gated, compressed, EQ'd channel strips into hardware outputs and virtual microphones, with VBAN network audio, reverb and echo sends, bus EQ and macro buttons. Built natively on PipeWire.",
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "sound",
        "desktopTemplate": "../packaging/linuxmeeter.desktop",
        "depends": ["pipewire (>= 1.4)", "libspa-0.2-modules (>= 1.4)", "wireplumber", "lsp-plugins-lv2"]
      }
    }
  }
}
